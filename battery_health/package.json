{
  "name": "ev-battery-care-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "convert:data": "python3 scripts/convert-battery-xlsx-to-json.py",
    "validate:data": "python3 scripts/validate-battery-json.py",
    "generate:scenarios": "python3 scripts/generate-charging-scenarios.py",
    "validate:scenarios": "python3 scripts/generate-charging-scenarios.py --check && python3 -m unittest discover -s tests -p 'test_*.py'",
    "dev": "vite",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
