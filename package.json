{
  "name": "tbd-wonder-park",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node park/server.mjs",
    "build": "vite build --config park/vite.config.mjs",
    "preview": "node park/server.mjs --production",
    "test": "vitest run --config park/vitest.config.mjs",
    "test:coverage": "vitest run --coverage --config park/vitest.config.mjs",
    "test:golden": "playwright test --config park/playwright.config.mjs",
    "test:golden:update": "playwright test --config park/playwright.config.mjs --update-snapshots",
    "reports": "node park/scripts/report.mjs",
    "park:watch": "node park/scripts/watch.mjs",
    "park:sync": "node park/scripts/watch.mjs --once",
    "park:circuit": "node park/scripts/circuit.mjs",
    "park:hooks": "node park/scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@vitest/coverage-v8": "4.1.11",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
