{
  "name": "vitalis-health-twin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:health": "tsc -p tsconfig.health.json && vite build --config vite.health.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/health.test.ts",
    "test:e2e": "playwright test",
    "test:game": "node --import tsx --test tests/game.test.ts",
    "test:game:e2e": "playwright test --config playwright.game.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
